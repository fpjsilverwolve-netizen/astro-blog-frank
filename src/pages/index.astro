---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		---
import BaseLayout from '../layouts/BaseLayout.astro'; // 根据你的博客布局路径调整
import WebstackNav from '../components/WebstackNav.astro';
---

<BaseLayout title="我的博客首页">
  <main class="max-w-7xl mx-auto px-4 py-8">
    <!-- 博客原有的欢迎语或文章列表（可选） -->
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-extrabold text-gray-900 dark:text-white">欢迎来到我的主页</h1>
      <p class="text-gray-600 dark:text-gray-400 mt-2">这里收录了我常用的高质量网站和开发工具。</p>
    </div>

    <!-- 集成 Webstack 导航 -->
    <WebstackNav />
  </main>
</BaseLayout>
		<Footer />
	</body>
</html>
