---
import navData from '../data/navData.json';
---

<div class="space-y-10 my-8">
  {
    navData.map((group) => (
      <section>
        <!-- 分类标题 -->
        <div class="flex items-center gap-2 pb-2 border-b border-gray-200 dark:border-gray-800 mb-4">
          <h2 class="text-xl font-bold text-gray-800 dark:text-gray-100">{group.category}</h2>
        </div>

        <!-- 卡片网格 -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {
            group.items.map((item) => (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-start p-3 rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 hover:shadow-md hover:border-blue-500 dark:hover:border-blue-500 transition-all duration-200 group"
              >
                <!-- 网站图标 -->
                <div class="flex-shrink-0 w-10 h-10 mr-3 flex items-center justify-center rounded-lg bg-gray-50 dark:bg-gray-800 border border-gray-100 dark:border-gray-700">
                  <img
                    src={item.icon}
                    alt={item.title}
                    class="w-5 h-5 object-contain"
                    onerror="this.src='/favicon.svg'"
                  />
                </div>

                <!-- 网站标题与描述 -->
                <div class="flex-1 min-w-0">
                  <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100 truncate group-hover:text-blue-600 dark:group-hover:text-blue-400">
                    {item.title}
                  </h3>
                  <p class="text-xs text-gray-500 dark:text-gray-400 mt-1 line-clamp-2 leading-relaxed">
                    {item.desc}
                  </p>
                </div>
              </a>
            ))
          }
        </div>
      </section>
    ))
  }
</div>
